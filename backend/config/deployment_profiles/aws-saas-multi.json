{
  "schema_version": 1,
  "profile_id": "aws-saas-multi",
  "display_name": "AIR AWS SaaS — Multi Tenant",
  "deployment": {
    "provider": "aws",
    "tenancy": "multi",
    "orchestrator": "ecs_fargate",
    "region": null,
    "region_required": true
  },
  "infrastructure": {
    "isolation": "tenant_scoped",
    "database": "rds_postgresql",
    "cache": "elasticache_redis",
    "message_broker": "amazon_mq_rabbitmq",
    "workflow_engine": "air_workflow",
    "storage": "efs_s3",
    "monitoring": "cloudwatch"
  },
  "services": {
    "frontend": true,
    "fastapi": true,
    "postgresql": true,
    "redis": true,
    "rabbitmq": true,
    "workflow_engine": true,
    "background_workers": true,
    "scheduler": true,
    "monitoring": true,
    "storage": true
  }
}
