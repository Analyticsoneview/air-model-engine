# Generate secrets outside source control.
# python -c "from secrets import token_urlsafe; print(token_urlsafe(48))"
AIR_JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIR_CREDENTIAL_KEY=
AIR_AUTH_DB_PATH=data/air_auth.sqlite3
AIR_ACCOUNT_DB_PATH=data/customer_accounts.sqlite3
AIR_CREDENTIAL_DB_PATH=data/air_credentials.sqlite3
AIR_ALLOW_CUSTOMER_SIGNUP=false

# Comma-separated customer UUIDs authorized to manage the app-wide Main Account.
AIR_OPERATOR_CUSTOMER_IDS=
AIR_ORDER_DB_PATH=data/air_orders.sqlite3

# Comma-separated exact origins allowed to call the API from browser/PWA clients.
AIR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
